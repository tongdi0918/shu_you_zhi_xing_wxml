<!-- pages/home/home.wxml -->
<view class="home-container">
  <!-- 顶部标题 -->
  <view class="header">
    <text class="title">🏞️ 蜀游智行</text>
    <text class="subtitle">探索四川之美</text>
  </view>

  <!-- 景区区域 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">🏛️ 热门景区</text>
      <text class="section-more" bindtap="refreshSceneries">🔄 换一批</text>
    </view>
    <view class="card-grid">
      <view class="card" wx:for="{{sceneries}}" wx:key="id" bindtap="goToScenic" data-id="{{item._id || item.id}}">
        <image class="card-image" src="bg.jpg" mode="aspectFill"></image>
        <view class="card-body">
          <text class="card-name">{{item.name}}</text>
          <view class="card-tags">
            <text class="tag">{{item.level || '景区'}}</text>
            <text class="tag city">{{item.city || '四川'}}</text>
          </view>
          <view class="card-footer">
            <text class="price">¥{{item.ticket_price || '0'}}</text>
            <text class="rating">⭐ {{item.rating || '4.5'}}</text>
          </view>
        </view>
      </view>
    </view>
    <view wx:if="{{loadingSceneries}}" class="loading-tip">加载中...</view>
  </view>

  <!-- 美食区域 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">🍜 特色美食</text>
      <text class="section-more" bindtap="refreshFoods">🔄 换一批</text>
    </view>
    <view class="card-grid">
      <view class="card" wx:for="{{foods}}" wx:key="id" bindtap="goToFood" data-id="{{item._id || item.id}}">
        <image class="card-image" src="bg.jpg" mode="aspectFill"></image>
        <view class="card-body">
          <text class="card-name">{{item.name}}</text>
          <view class="card-tags">
            <text class="tag">{{item.category || '美食'}}</text>
            <text class="tag city">{{item.city || '四川'}}</text>
          </view>
          <view class="card-footer">
            <text class="price">¥{{item.avg_price || '0'}}</text>
            <text class="rating">⭐ {{item.rating || '4.5'}}</text>
          </view>
        </view>
      </view>
    </view>
    <view wx:if="{{loadingFoods}}" class="loading-tip">加载中...</view>
  </view>
</view>