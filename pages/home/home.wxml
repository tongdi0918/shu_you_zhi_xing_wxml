<!-- pages/home/home.wxml -->
<view class="home-container">
  <!-- 头部 -->
  <view class="header">
    <text class="title"> 览迹🏔️记录者</text>
    <text class="subtitle">探索四川之美</text>
  </view>

  <!-- 热门景区 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">🏛️ 热门景区</text>
      <text class="section-more" bindtap="refreshSceneries">换一批</text>
    </view>
    <view class="card-grid" wx:if="{{!loadingSceneries && sceneries.length > 0}}">
      <view class="card" wx:for="{{sceneries}}" wx:key="_id" bindtap="goToScenic" data-id="{{item._id}}">
        <image class="card-image" src="{{item.image_url || '/images/fengjing.png'}}" mode="aspectFill" lazy-load></image>
        <view class="card-body">
          <text class="card-name">{{item.name}}</text>
          <view class="card-tags">
            <text class="tag">{{item.level || '景区'}}</text>
            <text class="tag city">{{item.city || '四川'}}</text>
          </view>
          <view class="card-footer">
            <text class="price">¥{{item.ticket_price || '0'}}</text>
            <text class="rating">⭐ {{item.rating || '4.5'}}</text>
          </view>
        </view>
      </view>
    </view>
    <view class="loading-tip" wx:elif="{{loadingSceneries}}">⏳ 加载景区中...</view>
    <view class="loading-tip" wx:elif="{{sceneries.length === 0}}">{{sceneryTip || '暂无景区数据'}}</view>
  </view>

  <!-- 特色美食 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">🍜 特色美食</text>
      <text class="section-more" bindtap="refreshFoods">换一批</text>
    </view>
    <view class="card-grid" wx:if="{{!loadingFoods && foods.length > 0}}">
      <view class="card" wx:for="{{foods}}" wx:key="_id" bindtap="goToFood" data-id="{{item._id}}">
        <image class="card-image" src="{{item.image_url || '/images/meishi.png'}}" mode="aspectFill" lazy-load></image>
        <view class="card-body">
          <text class="card-name">{{item.name}}</text>
          <view class="card-tags">
            <text class="tag">{{item.category || '美食'}}</text>
            <text class="tag city">{{item.city || '四川'}}</text>
          </view>
          <view class="card-footer">
            <text class="price">¥{{item.avg_price || '0'}}</text>
            <text class="rating">⭐ {{item.rating || '4.5'}}</text>
          </view>
        </view>
      </view>
    </view>
    <view class="loading-tip" wx:elif="{{loadingFoods}}">⏳ 加载美食中...</view>
    <view class="loading-tip" wx:elif="{{foods.length === 0}}">{{foodTip || '暂无美食数据'}}</view>
  </view>
</view>