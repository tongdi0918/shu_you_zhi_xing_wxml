/* pages/home/home.wxss */
.home-container {
  padding: 20rpx 30rpx 100rpx;
  background: #f5f7fa;
  min-height: 100vh;
}

.header {
  text-align: center;
  padding: 40rpx 0 30rpx;
  background: linear-gradient(135deg, #2d8cf0, #19be6b);
  border-radius: 24rpx;
  margin-bottom: 30rpx;
}
.header .title {
  font-size: 44rpx;
  font-weight: bold;
  color: #fff;
  display: block;
}
.header .subtitle {
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
  margin-top: 8rpx;
  display: block;
}

.section {
  margin-bottom: 40rpx;
}
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 10rpx 20rpx;
}
.section-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #2c3e50;
}
.section-more {
  font-size: 26rpx;
  color: #2d8cf0;
  padding: 8rpx 20rpx;
  background: #e8f0fe;
  border-radius: 30rpx;
}

.card-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.card {
  width: calc(50% - 16rpx);
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.08);
  margin-bottom: 24rpx;
  transition: all 0.3s;
}
.card:active {
  transform: scale(0.97);
}
.card-image {
  width: 100%;
  height: 200rpx;
  background: #eee;
}
.card-body {
  padding: 18rpx 20rpx 20rpx;
}
.card-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.card-tags {
  display: flex;
  gap: 12rpx;
  margin-top: 10rpx;
  flex-wrap: wrap;
}
.tag {
  font-size: 22rpx;
  color: #fff;
  background: #2d8cf0;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}
.tag.city {
  background: #19be6b;
}
.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 14rpx;
}
.price {
  font-size: 30rpx;
  font-weight: bold;
  color: #e74c3c;
}
.rating {
  font-size: 24rpx;
  color: #f39c12;
}

.loading-tip {
  text-align: center;
  padding: 20rpx;
  color: #999;
  font-size: 26rpx;
}