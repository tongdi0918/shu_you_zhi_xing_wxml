/* pages/home/home.wxss */
.home-container {
  padding: 20rpx 24rpx 100rpx;
  background: #f5f7fa;
  min-height: 100vh;
}

.header {
  text-align: center;
  padding: 36rpx 0 28rpx;
  background: linear-gradient(135deg, #2d8cf0, #19be6b);
  border-radius: 24rpx;
  margin-bottom: 30rpx;
}
.header .title {
  font-size: 44rpx;
  font-weight: bold;
  color: #fff;
  display: block;
}
.header .subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 8rpx;
  display: block;
}

.section {
  margin-bottom: 40rpx;
}
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 6rpx 20rpx;
}
.section-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #2c3e50;
}
.section-more {
  font-size: 26rpx;
  color: #2d8cf0;
  padding: 8rpx 24rpx;
  background: #e8f0fe;
  border-radius: 30rpx;
}

.card-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.card {
  width: calc(50% - 14rpx);
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.07);
  margin-bottom: 20rpx;
  transition: all 0.25s ease;
  border: 1rpx solid rgba(0, 0, 0, 0.03);
}
.card:active {
  transform: scale(0.96);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.10);
}

.card-image {
  width: 100%;
  height: 180rpx;
  background: #e8ecf1;
  display: block;
}

.card-body {
  padding: 14rpx 16rpx 18rpx;
}
.card-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.card-tags {
  display: flex;
  gap: 10rpx;
  margin-top: 8rpx;
  flex-wrap: wrap;
}
.tag {
  font-size: 20rpx;
  color: #fff;
  background: #2d8cf0;
  padding: 2rpx 14rpx;
  border-radius: 20rpx;
  line-height: 1.6;
}
.tag.city {
  background: #19be6b;
}
.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
}
.price {
  font-size: 28rpx;
  font-weight: bold;
  color: #e74c3c;
}
.rating {
  font-size: 22rpx;
  color: #f39c12;
}

.loading-tip {
  text-align: center;
  padding: 30rpx 0;
  color: #999;
  font-size: 26rpx;
}