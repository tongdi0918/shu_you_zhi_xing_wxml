.manager-container {
  padding: 30rpx;
  background: #f5f5f5;
  min-height: 100vh;
}
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}
.title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
}
.add-btn {
  background: #FF6B35;
  color: white;
  border: none;
  border-radius: 40rpx;
  padding: 12rpx 32rpx;
  font-size: 26rpx;
}
.item {
  display: flex;
  align-items: center;
  background: white;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.04);
}
.item image {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}
.item .info {
  flex: 1;
  margin-left: 20rpx;
}
.item .name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  display: block;
}
.item .city {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-top: 4rpx;
}
.item .actions {
  display: flex;
  gap: 20rpx;
}
.item .actions text {
  font-size: 26rpx;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
}
.edit {
  color: #2196F3;
  background: #E3F2FD;
}
.delete {
  color: #D32F2F;
  background: #FFEBEE;
}
.empty {
  text-align: center;
  padding: 120rpx 0;
  color: #ccc;
  font-size: 28rpx;
}