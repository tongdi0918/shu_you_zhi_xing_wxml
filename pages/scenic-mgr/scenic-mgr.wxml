<!-- pages/scenic-mgr/scenic-mgr.wxml -->
<view class="mgr-container">
  <view class="mgr-header">
    <text class="mgr-title">🏞️ 景区管理</text>
    <button class="add-btn" bindtap="addScenic">+ 添加</button>
  </view>

  <view wx:if="{{list.length === 0}}" class="empty-state">
    <text class="empty-text">暂无景区数据</text>
  </view>

  <view wx:for="{{list}}" wx:key="_id" class="grid-card mgr-item">
    <image class="mgr-thumb" src="{{item.thumbnail || '/images/fengjing.png'}}" mode="aspectFill"></image>
    <view class="mgr-info">
      <text class="mgr-name">{{item.name}}</text>
      <text class="mgr-desc">{{item.city || ''}} · {{item.level || ''}}</text>
    </view>
    <view class="mgr-actions">
      <text class="mgr-edit" bindtap="editScenic" data-id="{{item._id}}">✏️</text>
      <text class="mgr-delete" bindtap="deleteScenic" data-id="{{item._id}}">🗑️</text>
    </view>
  </view>
</view>