/* pages/scenic/scenic.wxss */
page {
  background-color: #f5f6fa;
  padding-bottom: 30rpx;
}

.container {
  padding: 20rpx;
}

.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
  font-size: 30rpx;
  color: #999;
}

/* ===== 图片轮播 ===== */
.image-swiper {
  width: 100%;
  height: 420rpx;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.swiper-image {
  width: 100%;
  height: 100%;
}

/* ===== 卡片通用样式 ===== */
.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 30rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

/* ===== 卡片1: 基本信息 ===== */
.info-card .title-row {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}

.info-card .name {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a2e;
  flex: 1;
}

.info-card .level {
  font-size: 24rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #4a7cf7, #6c5ce7);
  padding: 6rpx 24rpx;
  border-radius: 30rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.info-card .rating-row {
  display: flex;
  justify-content: space-between;
  font-size: 28rpx;
  color: #666;
}

.info-card .rating {
  color: #f39c12;
  font-weight: 500;
}

.info-card .location {
  color: #999;
}

/* ===== 卡片2: 三列信息 ===== */
.row-card {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}

.row-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.row-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.row-value {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.row-divider {
  width: 2rpx;
  height: 64rpx;
  background: #eee;
}

/* ===== 卡片3: 文本介绍 ===== */
.text-card .card-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 16rpx;
}

.text-card .card-content {
  font-size: 28rpx;
  color: #444;
  line-height: 1.8;
}

/* ===== 卡片4: 标签 ===== */
.tags-card .card-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 16rpx;
}

.tags-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag {
  background: #eef3fe;
  color: #4a7cf7;
  font-size: 24rpx;
  padding: 10rpx 28rpx;
  border-radius: 30rpx;
}

/* ===== 底部操作栏 ===== */
.action-bar {
  display: flex;
  gap: 20rpx;
  margin-top: 8rpx;
}

.action-bar button {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.btn-favorite {
  background: #f0f0f0;
  color: #e6d91d;
}

.btn-favorite.active {
  background: linear-gradient(135deg, #ff6b6b, #ee5a24);
  color: #fff;
}

.btn-location {
  background: linear-gradient(135deg, #4a7cf7, #6c5ce7);
  color: #e6d91d;
}