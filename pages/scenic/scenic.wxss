/* pages/scenic/scenic.wxss */
page {
  background-color: #f5f6fa;
  padding-bottom: 30rpx;
}

.container {
  padding: 20rpx;
}

/* ===== 图片轮播 ===== */
.image-swiper {
  width: 100%;
  height: 400rpx;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}
.swiper-image {
  width: 100%;
  height: 100%;
}

/* ===== 卡片通用样式 ===== */
.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

/* ===== 基本信息卡片 ===== */
.info-card .title-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}
.info-card .name {
  font-size: 38rpx;
  font-weight: 700;
  color: #1a1a2e;
  flex: 1;
}
.info-card .level {
  font-size: 24rpx;
  color: #ffffff;
  background: #4a7cf7;
  padding: 6rpx 20rpx;
  border-radius: 30rpx;
}
.info-card .rating-row {
  display: flex;
  justify-content: space-between;
  font-size: 28rpx;
  color: #666;
}
.info-card .rating {
  color: #f39c12;
}
.info-card .city {
  color: #999;
}

/* ===== 双列卡片 ===== */
.row-card {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
}
.row-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.row-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 6rpx;
}
.row-value {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
}
.row-divider {
  width: 2rpx;
  height: 60rpx;
  background: #eee;
}

/* ===== 文本卡片 ===== */
.text-card .card-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 16rpx;
}
.text-card .card-content {
  font-size: 28rpx;
  color: #444;
  line-height: 1.8;
}
.story-card {
  background: #faf3e8;
}
.story-card .card-title {
  color: #b87333;
}

/* ===== 标签卡片 ===== */
.tags-card .card-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 16rpx;
}
.tags-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.tag {
  background: #eef3fe;
  color: #4a7cf7;
  font-size: 24rpx;
  padding: 10rpx 28rpx;
  border-radius: 30rpx;
}

/* ===== 操作按钮 ===== */
.action-bar {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}
.action-bar button {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}
.btn-favorite {
  background: #f0f0f0;
  color: #666;
}
.btn-favorite.active {
  background: #ff6b6b;
  color: #fff;
}
.btn-ctrip {
  background: #ff6b35;
  color: #fff;
}
.route-wrap {
  padding: 0 4rpx;
}
.btn-route {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  background: #4a7cf7;
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ===== 加载中 ===== */
.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
  font-size: 32rpx;
  color: #999;
}