<!-- pages/scenic/scenic.wxml -->
<view class="container" wx:if="{{scenic.name}}">
  <!-- 图片轮播 -->
  <swiper class="image-swiper" indicator-dots="{{true}}" autoplay="{{true}}" interval="3000" circular="{{true}}">
    <swiper-item wx:for="{{scenic.images || defaultImages}}" wx:key="index">
      <image class="swiper-image" src="{{item}}" mode="aspectFill"></image>
    </swiper-item>
  </swiper>

  <!-- 基本信息卡片 -->
  <view class="card info-card">
    <view class="title-row">
      <text class="name">{{scenic.name}}</text>
      <text class="level">{{scenic.level || '景区'}}</text>
    </view>
    <view class="rating-row">
      <text class="rating">⭐ {{scenic.rating || '4.5'}} 分</text>
      <text class="city">{{scenic.city || '四川'}}</text>
    </view>
  </view>

  <!-- 门票与开放时间卡片（双列布局） -->
  <view class="card row-card">
    <view class="row-item">
      <text class="row-label">🎫 门票</text>
      <text class="row-value">¥{{scenic.ticket_price || '0'}} / 人</text>
    </view>
    <view class="row-divider"></view>
    <view class="row-item">
      <text class="row-label">🕐 开放时间</text>
      <text class="row-value">{{scenic.open_time || '08:00 - 18:00'}}</text>
    </view>
  </view>

  <!-- 景区介绍卡片 -->
  <view class="card text-card">
    <text class="card-title">📖 景区介绍</text>
    <text class="card-content">{{scenic.description || '暂无介绍'}}</text>
  </view>

  <!-- 背后的故事卡片 -->
  <view class="card text-card story-card">
    <text class="card-title">📜 背后的故事</text>
    <text class="card-content">{{scenic.story || '暂无故事'}}</text>
  </view>

  <!-- 标签卡片 -->
  <view class="card tags-card">
    <text class="card-title">🏷️ 标签</text>
    <view class="tags-wrap">
      <text class="tag" wx:for="{{scenic.tags || ['自然风光', '历史文化', '摄影圣地']}}" wx:key="index">{{item}}</text>
    </view>
  </view>

  <!-- 操作按钮组 -->
  <view class="action-bar">
    <button class="btn-favorite {{isFavorite ? 'active' : ''}}" bindtap="toggleFavorite">
      {{isFavorite ? '❤️ 已收藏' : '🤍 收藏'}}
    </button>
    <button class="btn-ctrip" bindtap="goToCtrip">✈️ 携程订票</button>
  </view>

  <!-- 路线规划按钮 -->
  <view class="route-wrap">
    <button class="btn-route" bindtap="goToRoute">🗺️ 路线规划</button>
  </view>
</view>

<!-- 加载中 -->
<view class="loading" wx:else>
  <text>加载中...</text>
</view>