<!-- pages/scenic/scenic.wxml -->
<view class="container" wx:if="{{scenic.name}}">
  <!-- 图片轮播 -->
  <swiper class="image-swiper" indicator-dots="{{true}}" autoplay="{{true}}" interval="3000" circular="{{true}}" wx:if="{{imageList.length > 0}}">
    <swiper-item wx:for="{{imageList}}" wx:key="index">
      <image class="swiper-image" src="{{item}}" mode="aspectFill" />
    </swiper-item>
  </swiper>
  <view class="image-placeholder" wx:else>
    <text>暂无图片</text>
  </view>

  <!-- 卡片1: 基本信息 -->
  <view class="card info-card">
    <view class="title-row">
      <text class="name">{{scenic.name}}</text>
      <text class="level">{{scenic.level || '景区'}}</text>
    </view>
    <view class="rating-row">
      <text class="rating">⭐ {{scenic.rating || '4.5'}} 分</text>
      <text class="location">{{scenic.city || ''}}{{scenic.address ? ' · ' + scenic.address : ''}}</text>
    </view>
  </view>

  <!-- 卡片2: 三列信息 -->
  <view class="card row-card">
    <view class="row-item">
      <text class="row-label">门票</text>
      <text class="row-value">¥{{scenic.ticket_price || '0'}}</text>
    </view>
    <view class="row-divider"></view>
    <view class="row-item">
      <text class="row-label">开放时间</text>
      <text class="row-value">{{scenic.open_time || '暂无'}}</text>
    </view>
    <view class="row-divider"></view>
    <view class="row-item">
      <text class="row-label">最佳季节</text>
      <text class="row-value">{{scenic.best_season || '全年'}}</text>
    </view>
  </view>

  <!-- 卡片3: 景区介绍 -->
  <view class="card text-card">
    <text class="card-title">📖 景区介绍</text>
    <text class="card-content">{{scenic.description || '暂无介绍'}}</text>
  </view>

  <!-- 卡片4: 标签 -->
  <view class="card tags-card" wx:if="{{scenic.tags && scenic.tags.length > 0}}">
    <text class="card-title">🏷️ 标签</text>
    <view class="tags-wrap">
      <text class="tag" wx:for="{{scenic.tags}}" wx:key="index">{{item}}</text>
    </view>
  </view>

  <!-- 底部操作栏（收藏 + 携程跳转） -->
  <view class="action-bar">
    <button class="btn-favorite" bindtap="toggleFavorite">
      {{isFavorite ? '❤️ 已收藏' : '☆ 收藏'}}
    </button>
    <button class="btn-ctrip" bindtap="goToCtrip">前往携程查看酒店</button>
  </view>
</view>

<!-- 加载中 -->
<view class="loading" wx:else>
  <text>加载中...</text>
</view>