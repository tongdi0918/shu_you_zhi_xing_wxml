/* pages/favorites/favorites.wxss */
.favorites-container {
  background: #f5f5f5;
  min-height: 100vh;
  padding: 20rpx;
}

.tab-bar {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}
.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 30rpx;
  color: #666;
  transition: all 0.3s;
}
.tab-item.active {
  color: #FF6B35;
  background: #fff5f0;
  font-weight: bold;
  border-bottom: 4rpx solid #FF6B35;
}

.list-container {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.item-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
  position: relative;
  transition: all 0.2s;
}
.item-card:active {
  transform: scale(0.98);
  background: #fafafa;
}

.item-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #e8e8e8;
}
.item-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.item-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}
.item-location {
  font-size: 24rpx;
  color: #999;
}
.item-remove {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #f0f0f0;
  text-align: center;
  line-height: 48rpx;
  font-size: 28rpx;
  color: #999;
  flex-shrink: 0;
}
.item-remove:active {
  background: #ff6b6b;
  color: #fff;
}

.empty-tip {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding: 80rpx 0;
}