/* pages/favorites/favorites.wxss */
.favorites-container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding: 20rpx;
}

.tab-bar {
  display: flex;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #999;
  border-radius: 12rpx;
  transition: all 0.3s;
}

.tab-item.active {
  background-color: #07C160;
  color: #ffffff;
  font-weight: bold;
}

.content-area {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx;
  min-height: 400rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.list-item {
  margin-bottom: 16rpx;
}

.item-block {
  background-color: #f8f8f8;
  border-radius: 12rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 2rpx solid #eee;
  transition: all 0.2s;
}

.item-block:active {
  transform: scale(0.98);
  border-color: #07C160;
}

.item-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.item-location {
  font-size: 24rpx;
  color: #999;
  flex: 1;
  margin: 0 16rpx;
}

.item-remove {
  font-size: 32rpx;
  color: #ff6b6b;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}

.item-remove:active {
  background-color: #fff0f0;
}

.empty {
  text-align: center;
  padding: 80rpx 0;
  font-size: 28rpx;
  color: #999;
}