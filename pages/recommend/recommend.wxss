/* pages/recommend/recommend.wxss */

.container {
  padding: 16rpx 24rpx 200rpx 24rpx;
  background-color: #f8f8f8;
  min-height: 100vh;
}

/* ===== 顶部栏 ===== */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #ffffff;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.location-info {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 26rpx;
  color: #666;
}

.location-city {
  color: #FF6B35;
  font-weight: 600;
  font-size: 28rpx;
}

.city-selector {
  flex-shrink: 0;
}

.picker-display {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #f5f5f5;
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #333;
}

.picker-label {
  color: #999;
}

.picker-value {
  color: #FF6B35;
  font-weight: 500;
}

.picker-arrow {
  color: #999;
  font-size: 20rpx;
}

/* ===== Tab切换 ===== */
.tab-bar {
  display: flex;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 6rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: #888;
  border-radius: 12rpx;
  transition: all 0.2s;
}

.tab-item.active {
  background: #FF6B35;
  color: #ffffff;
  font-weight: 500;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 53, 0.25);
}

/* ===== 卡片列表（小矩形块） ===== */
.card-list {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  justify-content: flex-start;
}

.card-item {
  width: calc(50% - 12rpx);
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  border: 3rpx solid transparent;
  transition: all 0.25s ease;
  position: relative;
  box-sizing: border-box;
  min-height: 140rpx;
  display: flex;
  align-items: center;
}

.card-item.checked {
  border-color: #FF6B35;
  background: #fff8f5;
  box-shadow: 0 4rpx 20rpx rgba(255, 107, 53, 0.15);
}

.card-check-mark {
  position: absolute;
  top: 8rpx;
  right: 12rpx;
  width: 36rpx;
  height: 36rpx;
  background: #FF6B35;
  color: #fff;
  border-radius: 50%;
  font-size: 22rpx;
  text-align: center;
  line-height: 36rpx;
  font-weight: bold;
  box-shadow: 0 2rpx 8rpx rgba(255, 107, 53, 0.3);
}

.card-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  overflow: hidden;
}

.card-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.3;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.card-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  color: #888;
}

.card-city {
  color: #666;
}

.card-tag {
  background: #f0f0f0;
  padding: 2rpx 14rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #888;
}

.card-price {
  font-size: 28rpx;
  color: #FF6B35;
  font-weight: 600;
  margin-top: 4rpx;
}

/* ===== 空状态 & 加载 ===== */
.empty-state,
.loading-state {
  text-align: center;
  padding: 80rpx 0;
  color: #bbb;
  font-size: 28rpx;
}

/* ===== 底部操作栏 ===== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
  flex-wrap: wrap;
  gap: 12rpx;
}

.selected-count {
  font-size: 28rpx;
  color: #666;
}

.count-num {
  color: #FF6B35;
  font-weight: 700;
  font-size: 34rpx;
}

.action-buttons {
  display: flex;
  gap: 16rpx;
}

.btn {
  padding: 16rpx 32rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  border: none;
  outline: none;
  font-weight: 500;
}

.btn-clear {
  background: #f5f5f5;
  color: #888;
}

.btn-clear:active {
  background: #e8e8e8;
}

.btn-generate {
  background: #FF6B35;
  color: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 53, 0.3);
}

.btn-generate:active {
  opacity: 0.85;
}

/* ===== 行程方案区域 ===== */
.plan-section {
  margin-top: 30rpx;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx 24rpx 16rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.plan-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.plan-city-group {
  margin-bottom: 24rpx;
}

.plan-city-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.plan-city-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #FF6B35;
}

.plan-city-count {
  font-size: 24rpx;
  color: #999;
  background: #f5f5f5;
  padding: 4rpx 18rpx;
  border-radius: 20rpx;
}

/* 同一城市的项目在一行内横向排列 */
.plan-items-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.plan-item {
  background: #f8f8f8;
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #333;
  border: 1rpx solid #eee;
}

.plan-item-name {
  font-weight: 500;
}

.plan-item-type {
  color: #999;
  font-size: 22rpx;
  background: #fff;
  padding: 0 10rpx;
  border-radius: 12rpx;
}