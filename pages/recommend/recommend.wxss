/* 首页样式 */
.container {
  padding-bottom: 40rpx;
  background: #f8f8f8;
}

.section {
  margin: 20rpx 30rpx;
}
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.section-header text:first-child {
  font-size: 32rpx;
  font-weight: 600;
}
.refresh {
  color: #FF6B35;
  font-size: 26rpx;
}
.scenic-card, .food-card {
  background: white;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.04);
}
.scenic-card image, .food-card image {
  width: 100%;
  height: 360rpx;
}
.card-info {
  padding: 20rpx;
}
.card-info .name {
  font-size: 32rpx;
  font-weight: 600;
}
.card-info .level, .card-info .category {
  display: inline-block;
  background: #FF6B35;
  color: white;
  padding: 2rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  margin-left: 12rpx;
}
.card-info .city {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}
.card-info .desc {
  display: block;
  font-size: 26rpx;
  color: #444;
  margin: 8rpx 0;
}
.card-info .price {
  display: block;
  font-size: 26rpx;
  color: #FF6B35;
}
.empty {
  text-align: center;
  padding: 60rpx 0;
  color: #ccc;
  font-size: 26rpx;
}
.header { text-align: center; padding: 40rpx 30rpx 20rpx; background: white; }
.header .title { font-size: 40rpx; font-weight: 700; color: #333; }
.header .subtitle { font-size: 26rpx; color: #999; margin-top: 10rpx; display: block; }