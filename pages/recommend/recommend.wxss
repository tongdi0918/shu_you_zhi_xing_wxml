/* pages/recommend/recommend.wxss */
.container {
  padding: 20rpx 30rpx 40rpx;
  background: #f5f7fa;
  min-height: 100vh;
}

/* ===== 当前位置 ===== */
.location-bar {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 24rpx;
}
.location-label {
  font-size: 28rpx;
  color: #666;
}
.location-text {
  font-size: 30rpx;
  color: #333;
  font-weight: 600;
  margin-left: 12rpx;
}

/* ===== 城市筛选下拉 ===== */
.filter-bar {
  margin-bottom: 24rpx;
}
.picker-display {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}
.picker-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}
.picker-text {
  flex: 1;
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}
.picker-arrow {
  font-size: 24rpx;
  color: #999;
}

/* ===== Tab切换 ===== */
.tab-bar {
  display: flex;
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 24rpx;
}
.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 30rpx;
  color: #888;
  transition: all 0.3s;
}
.tab-item.active {
  color: #ffffff;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  font-weight: 600;
}

/* ===== 卡片列表 ===== */
.card-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 24rpx;
}
.card-item {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  transition: all 0.3s;
  border: 3rpx solid transparent;
}
.card-item.checked {
  border-color: #667eea;
  background: #f0f2ff;
  box-shadow: 0 4rpx 24rpx rgba(102, 126, 234, 0.25);
}
.card-check {
  margin-right: 24rpx;
}
.checkbox {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 3rpx solid #ddd;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #fff;
  transition: all 0.3s;
}
.checkbox.checked {
  background: #667eea;
  border-color: #667eea;
}
.card-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.card-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}
.card-desc {
  font-size: 26rpx;
  color: #888;
}
.card-price {
  font-size: 28rpx;
  color: #ff6b6b;
  font-weight: 500;
}
.empty-tip,
.loading-tip {
  text-align: center;
  padding: 60rpx 0;
  font-size: 28rpx;
  color: #aaa;
}

/* ===== 已选数量 ===== */
.selected-info {
  display: inline-block;
  padding: 16rpx 32rpx;
  background: #667eea;
  color: #fff;
  border-radius: 30rpx;
  font-size: 26rpx;
  margin-bottom: 24rpx;
}

/* ===== 操作按钮 ===== */
.action-bar {
  display: flex;
  gap: 20rpx;
  margin-bottom: 32rpx;
}
.btn-primary,
.btn-danger {
  flex: 1;
  padding: 28rpx 0;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s;
}
.btn-primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}
.btn-primary:active {
  transform: scale(0.97);
}
.btn-danger {
  background: #fff;
  color: #e74c3c;
  border: 3rpx solid #e74c3c;
}
.btn-danger:active {
  transform: scale(0.97);
  background: #fef0ef;
}

/* ===== 行程方案 ===== */
.plan-section {
  margin-top: 10rpx;
}
.plan-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 24rpx;
  padding-left: 8rpx;
}
.plan-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.plan-group {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx 28rpx 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}
.plan-group-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  padding-bottom: 18rpx;
  border-bottom: 2rpx solid #f0f0f0;
  margin-bottom: 18rpx;
}
.plan-items {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.plan-item {
  display: inline-flex;
  align-items: center;
  padding: 14rpx 24rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
  gap: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.plan-item-name {
  font-size: 26rpx;
  color: #333;
}
.plan-item-type {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
}
.plan-item-type.type-scenic {
  background: #e8f0fe;
  color: #4a7ec7;
}
.plan-item-type.type-food {
  background: #fef3e8;
  color: #d4883a;
}