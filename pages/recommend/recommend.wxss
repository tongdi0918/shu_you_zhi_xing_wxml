.recommend-container {
  padding: 30rpx;
  background: #f5f5f5;
  min-height: 100vh;
}
.title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
}
.subtitle {
  display: block;
  font-size: 26rpx;
  color: #999;
  margin: 10rpx 0 30rpx;
}
.section {
  margin-bottom: 30rpx;
}
.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}
.scenic-card, .food-card {
  background: white;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.04);
}
.scenic-card image, .food-card image {
  width: 100%;
  height: 300rpx;
}
.card-info {
  padding: 20rpx;
}
.card-info .name {
  font-size: 30rpx;
  font-weight: 600;
}
.card-info .desc {
  font-size: 26rpx;
  color: #666;
  margin-top: 6rpx;
}
.empty {
  text-align: center;
  padding: 60rpx 0;
  color: #ccc;
  font-size: 26rpx;
}
.refresh-btn {
  display: inline-block;
  padding: 20rpx 50rpx;
  background: #FF6B35;
  color: white;
  border-radius: 40rpx;
  font-size: 28rpx;
  text-align: center;
  margin-top: 20rpx;
}