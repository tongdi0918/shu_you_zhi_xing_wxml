/* pages/recommend/recommend.wxss */
.recommend-container {
  padding: 20rpx 30rpx 100rpx;
  background: #f5f7fa;
  min-height: 100vh;
}

/* ===== 当前位置卡片 ===== */
.location-card {
  background: linear-gradient(135deg, #2d8cf0, #19be6b);
  border-radius: 20rpx;
  padding: 28rpx 30rpx;
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}
.location-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}
.location-text {
  font-size: 28rpx;
  color: rgba(255,255,255,0.9);
}
.location-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #fff;
  flex: 1;
  margin-left: 8rpx;
}
.location-refresh {
  font-size: 32rpx;
  color: #fff;
  padding: 8rpx 16rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 50%;
}

/* ===== 筛选区域 ===== */
.filter-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}
.filter-title {
  font-size: 26rpx;
  color: #666;
  display: block;
  margin-bottom: 16rpx;
}
.filter-scroll {
  white-space: nowrap;
}
.filter-group {
  display: inline-flex;
  gap: 16rpx;
}
.filter-item {
  display: inline-block;
  padding: 12rpx 32rpx;
  font-size: 26rpx;
  color: #666;
  background: #f0f2f5;
  border-radius: 40rpx;
  transition: all 0.3s;
}
.filter-item.active {
  color: #fff;
  background: #2d8cf0;
}

/* ===== 类型切换Tabs ===== */
.type-tabs {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}
.type-tabs .tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: #666;
  border-radius: 16rpx;
  transition: all 0.3s;
}
.type-tabs .tab.active {
  color: #fff;
  background: #2d8cf0;
  font-weight: 500;
}

/* ===== 推荐列表 ===== */
.recommend-list {
  margin-bottom: 30rpx;
}
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 10rpx 20rpx;
}
.section-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #2c3e50;
}
.section-more {
  font-size: 26rpx;
  color: #2d8cf0;
  padding: 8rpx 20rpx;
  background: #e8f0fe;
  border-radius: 30rpx;
}

.card-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.card {
  width: calc(50% - 16rpx);
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.08);
  margin-bottom: 24rpx;
  transition: all 0.3s;
}
.card:active {
  transform: scale(0.97);
}
.card-image {
  width: 100%;
  height: 200rpx;
  background: #eee;
}
.card-body {
  padding: 18rpx 20rpx 20rpx;
}
.card-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.card-tags {
  display: flex;
  gap: 12rpx;
  margin-top: 10rpx;
  flex-wrap: wrap;
}
.tag {
  font-size: 22rpx;
  color: #fff;
  background: #2d8cf0;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}
.tag.city {
  background: #19be6b;
}
.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 14rpx;
}
.price {
  font-size: 30rpx;
  font-weight: bold;
  color: #e74c3c;
}
.rating {
  font-size: 24rpx;
  color: #f39c12;
}

.empty-tip {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* ===== 行程规划 ===== */
.itinerary-section {
  margin-top: 10rpx;
}
.itinerary-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}
.itinerary-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f0f2f5;
}
.itinerary-city {
  font-size: 32rpx;
  font-weight: bold;
  color: #2c3e50;
}
.itinerary-count {
  font-size: 24rpx;
  color: #999;
  background: #f5f7fa;
  padding: 4rpx 20rpx;
  border-radius: 20rpx;
}
.itinerary-items {
  margin-top: 16rpx;
}
.itinerary-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f7fa;
}
.itinerary-item:last-child {
  border-bottom: none;
}
.item-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}
.item-info {
  flex: 1;
}
.item-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #1a1a1a;
  display: block;
}
.item-desc {
  font-size: 24rpx;
  color: #999;
}
.item-arrow {
  font-size: 32rpx;
  color: #ccc;
}