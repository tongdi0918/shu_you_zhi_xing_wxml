/* pages/recommend/recommend.wxss */
.recommend-container {
  padding: 20rpx 30rpx 120rpx;
  background: #f5f7fa;
  min-height: 100vh;
}

/* ===== 顶部栏 ===== */
.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
  margin-bottom: 20rpx;
}

.location-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.location-icon { font-size: 32rpx; }
.location-text { font-size: 26rpx; color: #666; }

.city-picker { flex-shrink: 0; }
.picker-display {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: #e8f0fe;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
}
.city-name { font-size: 28rpx; font-weight: 600; color: #2d8cf0; }
.arrow { font-size: 22rpx; color: #2d8cf0; }

/* ===== Tab栏 ===== */
.tab-bar {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 30rpx;
  color: #999;
  transition: all 0.3s;
  border-bottom: 4rpx solid transparent;
}
.tab-item.active {
  color: #2d8cf0;
  border-bottom-color: #2d8cf0;
  font-weight: 600;
}

/* ===== 卡片列表（小矩形块布局） ===== */
.card-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.card-item {
  width: calc(50% - 16rpx);
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.08);
  margin-bottom: 24rpx;
  transition: all 0.3s;
  position: relative;
}
.card-item:active { transform: scale(0.97); }

/* 复选框 */
.card-check {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  z-index: 10;
}
.checkbox {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 3rpx solid #ddd;
  background: rgba(255,255,255,0.85);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #fff;
  transition: all 0.3s;
}
.checkbox.checked {
  background: #2d8cf0;
  border-color: #2d8cf0;
}

.card-content { display: block; }

.card-img {
  width: 100%;
  height: 200rpx;
  background: #eee;
  display: block;
}

.card-info {
  padding: 18rpx 20rpx 20rpx;
}

.card-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-city {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-top: 4rpx;
}

.card-tags {
  display: flex;
  gap: 12rpx;
  margin-top: 10rpx;
  flex-wrap: wrap;
}
.tag {
  font-size: 22rpx;
  color: #fff;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}
.tag.level { background: #2d8cf0; }
.tag.category { background: #19be6b; }

.card-price {
  margin-top: 12rpx;
}
.price {
  font-size: 30rpx;
  font-weight: bold;
  color: #e74c3c;
}

/* ===== 空状态 ===== */
.empty-state {
  text-align: center;
  padding: 120rpx 0;
}
.empty-icon { font-size: 80rpx; display: block; }
.empty-text { font-size: 28rpx; color: #999; margin-top: 20rpx; display: block; }

/* ===== 加载中 ===== */
.loading-state {
  text-align: center;
  padding: 80rpx 0;
}
.loading-text { font-size: 28rpx; color: #999; }

/* ===== 底部操作栏 ===== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 30rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.08);
  display: flex;
  justify-content: space-between;
  align-items: center;
  z-index: 100;
}
.bottom-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.selected-count { font-size: 26rpx; color: #333; }
.clear-btn { font-size: 26rpx; color: #e74c3c; padding: 8rpx 16rpx; }
.btn-generate {
  background: linear-gradient(135deg, #2d8cf0, #19be6b);
  color: #fff;
  border: none;
  border-radius: 40rpx;
  padding: 16rpx 40rpx;
  font-size: 28rpx;
  font-weight: 600;
}

/* ===== 行程方案 ===== */
.plan-section {
  margin-top: 30rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.plan-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 20rpx;
}
.plan-item {
  border-bottom: 1rpx solid #f0f0f0;
  padding: 16rpx 0;
}
.plan-item:last-child { border-bottom: none; }
.plan-city {
  font-size: 28rpx;
  font-weight: 600;
  color: #2d8cf0;
  margin-bottom: 10rpx;
}
.plan-items {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.plan-sub {
  background: #f5f7fa;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.plan-sub-name { font-size: 24rpx; color: #333; }
.plan-sub-type { font-size: 20rpx; color: #999; }