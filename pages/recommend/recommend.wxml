<!-- pages/recommend/recommend.wxml -->
<view class="recommend-container">

<!-- ===== 顶部栏 ===== -->
<view class="top-bar">
  <view class="location-info">
    <text class="location-icon">📍</text>
    <text class="location-text">{{userLocation.city || '未设置'}}</text>
  </view>
  <picker class="city-picker" mode="selector" range="{{cityList}}" value="{{selectedCityIndex}}" bindchange="onCityChange">
    <view class="picker-display">
      <text class="city-name">{{cityList[selectedCityIndex] || '选择城市'}}</text>
      <text class="arrow">▼</text>
    </view>
  </picker>
</view>

<!-- ===== Tab栏 ===== -->
<view class="tab-bar">
  <view class="tab-item {{activeTab === 'scenic' ? 'active' : ''}}" data-tab="scenic" bindtap="switchTab">
    🏞️ 景区
  </view>
  <view class="tab-item {{activeTab === 'food' ? 'active' : ''}}" data-tab="food" bindtap="switchTab">
    🍜 美食
  </view>
</view>

<!-- ===== 卡片列表 ===== -->
<view class="card-list" wx:if="{{displayList.length > 0}}">
  <view class="card-item" wx:for="{{displayList}}" wx:key="_id" bindtap="toggleCard" data-id="{{item._id}}">
    <view class="card-check">
      <view class="checkbox {{item.checked ? 'checked' : ''}}">
        <text wx:if="{{item.checked}}">✓</text>
      </view>
    </view>
    <view class="card-content">
      <image class="card-img" src="{{item.image}}" mode="aspectFill" ></image>
      <view class="card-info">
        <text class="card-name">{{item.name}}</text>
        <text class="card-city">{{item.city}}</text>
        <text class="card-tag">{{item.type === 'scenic' ? (item.level || '景区') : (item.category || '美食')}}</text>
        <text class="card-price">¥{{item.ticket_price || item.avg_price || '0'}}</text>
      </view>
    </view>
  </view>
</view>

<!-- 空状态 -->
<view class="empty-state" wx:if="{{displayList.length === 0 && !loading}}">
  <text>暂无数据，请检查</text>
</view>

<!-- 加载中 -->
<view class="loading-state" wx:if="{{loading}}">
  <text>加载中...</text>
</view>

<!-- ===== 底部操作栏 ===== -->
<view class="bottom-bar">
  <view class="selected-info">
    <text>已选 <text class="selected-count">{{selectedList.length}}</text> 项</text>
  </view>
  <view class="bottom-actions">
    <button class="btn-clear" bindtap="clearAll">🗑️ 清空所有</button>
    <button class="btn-generate" bindtap="generatePlan">🚀 推演行程方案</button>
  </view>
</view>

<!-- ===== 行程方案区域（重构后） ===== -->
<view class="plan-section" wx:if="{{planData.length > 0}}">
  <view class="plan-header">
    <text class="plan-title">📋 专属行程规划</text>
    <text class="plan-hint">{共 {{planData.length}} 个城市}</text>
  </view>

  <!-- 按城市分组 -->
  <view class="plan-city-group" wx:for="{{planData}}" wx:key="city">
    <!-- 城市标签 -->
    <view class="plan-city-header">
      <text class="city-name-label">🏙️ {{item.city}}</text>
      <text class="city-item-count">（{{item.items.length}} 项）</text>
    </view>

    <!-- 该城市下的小矩形块列表 -->
    <view class="plan-items">
      <view
        class="plan-item {{sub.type === 'scenic' ? 'plan-item-scenic' : 'plan-item-food'}}"
        wx:for="{{item.items}}"
        wx:key="_id"
        wx:for-item="sub"
        bindtap="viewPlanDetail"
        data-index="{{index}}"
      >
        <!-- 左上角顺序编号 -->
        <view class="plan-item-index">{{sub.planIndex}}</view>
        <!-- 项目名称 -->
        <view class="plan-item-name">{{sub.name}}</view>
        <!-- 类型小标签（可选） -->
        <view class="plan-item-type">{{sub.type === 'scenic' ? '景点' : '美食'}}</view>
      </view>
    </view>
  </view>
</view>

</view>