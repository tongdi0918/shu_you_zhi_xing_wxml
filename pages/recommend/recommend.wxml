<!-- pages/recommend/recommend.wxml -->
<view class="container">
  <!-- 顶部：当前位置 & 城市下拉 -->
  <view class="header">
    <view class="location-info">
      <text class="location-label">📍 当前位置</text>
      <text class="location-city">{{userLocation.city || '未设置'}}</text>
    </view>
    <view class="city-selector">
      <picker mode="selector" range="{{cityList}}" value="{{selectedCityIndex}}" bindchange="onCityChange">
        <view class="picker-display">
          <text class="picker-label">切换城市</text>
          <text class="picker-value">{{cityList[selectedCityIndex] || '选择城市'}}</text>
          <text class="picker-arrow">▼</text>
        </view>
      </picker>
    </view>
  </view>

  <!-- Tab切换：景区 / 美食 -->
  <view class="tab-bar">
    <view class="tab-item {{activeTab === 'scenic' ? 'active' : ''}}" bindtap="switchTab" data-tab="scenic">
      🏞️ 景区
    </view>
    <view class="tab-item {{activeTab === 'food' ? 'active' : ''}}" bindtap="switchTab" data-tab="food">
      🍜 美食
    </view>
  </view>

  <!-- 卡片列表 -->
  <view class="card-list" wx:if="{{!loading && displayList.length > 0}}">
    <view class="card-item {{item.checked ? 'checked' : ''}}" 
          wx:for="{{displayList}}" 
          wx:key="_id" 
          bindtap="toggleCard" 
          data-id="{{item._id}}">
      <view class="card-check-mark" wx:if="{{item.checked}}">✓</view>
      <view class="card-content">
        <view class="card-name">{{item.name}}</view>
        <view class="card-meta">
          <text class="card-city">{{item.city}}</text>
          <text class="card-tag" wx:if="{{item.type === 'scenic'}}">{{item.level || '景区'}}</text>
          <text class="card-tag" wx:if="{{item.type === 'food'}}">{{item.category || '美食'}}</text>
        </view>
        <view class="card-price">
          <text wx:if="{{item.type === 'scenic'}}">¥{{item.ticket_price || '0'}}</text>
          <text wx:if="{{item.type === 'food'}}">¥{{item.avg_price || '0'}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && displayList.length === 0}}">
    <text>暂无数据，请切换城市或检查网络</text>
  </view>

  <!-- 加载中 -->
  <view class="loading-state" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar">
    <view class="selected-count">
      已选 <text class="count-num">{{selectedList.length}}</text> 项
    </view>
    <view class="action-buttons">
      <button class="btn btn-clear" bindtap="clearAll">🗑️ 清空所有</button>
      <button class="btn btn-generate" bindtap="generatePlan">🚀 生成行程方案</button>
    </view>
  </view>

  <!-- 行程方案展示（按城市归纳为一行） -->
  <view class="plan-section" wx:if="{{planData.length > 0}}">
    <view class="plan-title">📋 我的行程方案</view>
    <view class="plan-city-group" wx:for="{{planData}}" wx:key="city">
      <view class="plan-city-header">
        <text class="plan-city-name">📍 {{item.city}}</text>
        <text class="plan-city-count">{{item.items.length}}项</text>
      </view>
      <view class="plan-items-row">
        <view class="plan-item" wx:for="{{item.items}}" wx:for-item="sub" wx:key="_id">
          <text class="plan-item-name">{{sub.name}}</text>
          <text class="plan-item-type">{{sub.type === 'scenic' ? '景区' : '美食'}}</text>
        </view>
      </view>
    </view>
  </view>
</view>