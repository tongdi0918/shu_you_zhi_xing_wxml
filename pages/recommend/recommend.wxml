<view class="container">
  <view class="header">
    <text class="title">🎯 个性化推荐</text>
    <text class="subtitle">基于你的偏好，为你精选四川美景与美食</text>
  </view>

  <view class="section">
    <view class="section-header">
      <text>🏔️ 为你推荐景区</text>
      <text class="refresh" bindtap="refreshRecommend">刷新推荐</text>
    </view>
    <view wx:for="{{recommendedSceneries}}" wx:key="_id" class="card" bindtap="goToScenic" data-id="{{item._id}}">
      <image src="{{item.image || '/images/default.jpg'}}" mode="aspectFill"></image>
      <view class="card-info">
        <text class="name">{{item.name}}</text>
        <text class="desc">{{item.description}}</text>
      </view>
    </view>
    <view wx:if="{{recommendedSceneries.length === 0 && !loading}}" class="empty">暂无推荐，先去浏览一些景区吧</view>
  </view>

  <view class="section">
    <view class="section-header">
      <text>🍜 为你推荐美食</text>
      <text class="refresh" bindtap="refreshRecommend">刷新推荐</text>
    </view>
    <view wx:for="{{recommendedFoods}}" wx:key="_id" class="card" bindtap="goToFood" data-id="{{item._id}}">
      <image src="{{item.image || '/images/default.jpg'}}" mode="aspectFill"></image>
      <view class="card-info">
        <text class="name">{{item.name}}</text>
        <text class="desc">{{item.description}}</text>
      </view>
    </view>
    <view wx:if="{{recommendedFoods.length === 0 && !loading}}" class="empty">暂无推荐，先去品尝一些美食吧</view>
  </view>
</view>