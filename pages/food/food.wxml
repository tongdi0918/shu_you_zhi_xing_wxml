<!-- pages/food/food.wxml -->
<view class="container" wx:if="{{food.name}}">
  <!-- 图片轮播 -->
  <swiper class="image-swiper" indicator-dots="{{true}}" autoplay="{{true}}" interval="3000" circular="{{true}}">
    <swiper-item wx:for="{{food.images || defaultImages}}" wx:key="index">
      <image class="swiper-image" src="{{item}}" mode="aspectFill"></image>
    </swiper-item>
  </swiper>

  <!-- 基本信息卡片 -->
  <view class="card info-card">
    <view class="title-row">
      <text class="name">{{food.name}}</text>
      <text class="category">{{food.category || '特色美食'}}</text>
    </view>
    <view class="rating-row">
      <text class="rating">⭐ {{food.rating || '4.5'}} 分</text>
      <text class="origin">{{food.origin || '四川'}}</text>
    </view>
  </view>

  <!-- 价格与营业时间卡片（双列布局） -->
  <view class="card row-card">
    <view class="row-item">
      <text class="row-label">💰 参考价格</text>
      <text class="row-value">¥{{food.price || '0'}} / 份</text>
    </view>
    <view class="row-divider"></view>
    <view class="row-item">
      <text class="row-label">🕐 营业时间</text>
      <text class="row-value">{{food.business_hours || '10:00 - 22:00'}}</text>
    </view>
  </view>

  <!-- 美食介绍卡片 -->
  <view class="card text-card">
    <text class="card-title">📖 美食介绍</text>
    <text class="card-content">{{food.description || '暂无介绍'}}</text>
  </view>

  <!-- 背后的故事卡片 -->
  <view class="card text-card story-card">
    <text class="card-title">📜 背后的故事</text>
    <text class="card-content">{{food.story || '暂无故事'}}</text>
  </view>

  <!-- 标签卡片 -->
  <view class="card tags-card">
    <text class="card-title">🏷️ 标签</text>
    <view class="tags-wrap">
      <text class="tag" wx:for="{{food.tags || ['麻辣鲜香', '传统名菜', '必吃打卡']}}" wx:key="index">{{item}}</text>
    </view>
  </view>

  <!-- 操作按钮组 -->
  <view class="action-bar">
    <button class="btn-favorite {{isFavorite ? 'active' : ''}}" bindtap="toggleFavorite">
      {{isFavorite ? '❤️ 已收藏' : '🤍 收藏'}}
    </button>
    <button class="btn-ctrip" bindtap="goToCtrip">✈️ 携程订餐</button>
  </view>

  <!-- 路线规划按钮 -->
  <view class="route-wrap">
    <button class="btn-route" bindtap="goToRoute">🗺️ 路线规划</button>
  </view>
</view>

<!-- 加载中 -->
<view class="loading" wx:else>
  <text>加载中...</text>
</view>