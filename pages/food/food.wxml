<!-- pages/food/food.wxml -->
<view class="food-container" wx:if="{{food.id}}">
  <!-- 头图 -->
  <image class="hero-image" src="{{food.image || '/images/default_food.jpg'}}" mode="aspectFill"></image>

  <!-- 主信息卡片 -->
  <view class="info-card">
    <text class="name">{{food.name}}</text>
    <view class="meta-row">
      <text class="category">{{food.category || '美食'}}</text>
      <text class="city">?? {{food.city || '四川'}}</text>
    </view>
    <view class="rating-row">
      <text class="rating">? {{food.rating || '4.5'}} 分</text>
      <text class="price">?? ￥{{food.avg_price || '0'}} / 人</text>
    </view>
  </view>

  <!-- 菜品介绍卡片 -->
  <view class="detail-card">
    <text class="detail-title">??? 菜品介绍</text>
    <text class="detail-content">{{food.description || '暂无介绍'}}</text>
  </view>

  <!-- 美食故事卡片 -->
  <view class="detail-card">
    <text class="detail-title">?? 美食故事</text>
    <text class="detail-content">{{food.story || '暂无故事'}}</text>
  </view>

  <!-- 标签卡片 -->
  <view class="detail-card">
    <text class="detail-title">??? 标签</text>
    <view class="tags-wrap">
      <text class="tag-item" wx:for="{{food.tags || ['川菜', '麻辣', '特色小吃']}}" wx:key="index">{{item}}</text>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="action-bar">
    <view class="action-btn favorite {{isFavorite ? 'active' : ''}}" bindtap="toggleFavorite">
      <text>{{isFavorite ? '?? 已收藏' : '?? 收藏'}}</text>
    </view>
    <view class="action-btn route" bindtap="goToRoute">
      <text>??? 路线规划</text>
    </view>
  </view>
</view>

<view wx:else class="empty-tip">加载中...</view>