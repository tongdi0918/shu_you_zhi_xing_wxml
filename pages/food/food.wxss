/* pages/food/food.wxss */
.food-container {
  padding-bottom: 140rpx;
  background: #f5f7fa;
  min-height: 100vh;
}

.hero-image {
  width: 100%;
  height: 420rpx;
  background: #ddd;
}

.info-card {
  background: #fff;
  margin: -40rpx 30rpx 20rpx;
  padding: 30rpx 28rpx;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 30rpx rgba(0,0,0,0.10);
}
.info-card .name {
  font-size: 38rpx;
  font-weight: bold;
  color: #1a1a1a;
  display: block;
}
.info-card .meta-row {
  display: flex;
  gap: 20rpx;
  margin-top: 12rpx;
}
.info-card .category {
  font-size: 24rpx;
  color: #fff;
  background: #19be6b;
  padding: 4rpx 20rpx;
  border-radius: 20rpx;
}
.info-card .city {
  font-size: 26rpx;
  color: #666;
}
.info-card .rating-row {
  display: flex;
  gap: 30rpx;
  margin-top: 14rpx;
}
.info-card .rating {
  font-size: 28rpx;
  color: #f39c12;
}
.info-card .price {
  font-size: 28rpx;
  color: #e74c3c;
  font-weight: bold;
}

.detail-card {
  background: #fff;
  margin: 0 30rpx 20rpx;
  padding: 26rpx 28rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}
.detail-card .detail-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #2c3e50;
  display: block;
  margin-bottom: 14rpx;
}
.detail-card .detail-content {
  font-size: 28rpx;
  color: #444;
  line-height: 1.8;
  display: block;
}

.tags-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.tag-item {
  font-size: 24rpx;
  color: #19be6b;
  background: #e8f5e9;
  padding: 8rpx 24rpx;
  border-radius: 30rpx;
}

.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background: #fff;
  padding: 16rpx 30rpx 30rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.08);
  gap: 16rpx;
}
.action-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 50rpx;
  font-size: 28rpx;
  font-weight: 500;
}
.action-btn.favorite {
  background: #f0f0f0;
  color: #666;
}
.action-btn.favorite.active {
  background: #fff0f0;
  color: #e74c3c;
}
.action-btn.route {
  background: #2d8cf0;
  color: #fff;
}

.empty-tip {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 30rpx;
}