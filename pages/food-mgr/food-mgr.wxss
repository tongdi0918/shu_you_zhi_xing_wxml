/* pages/food-mgr/food-mgr.wxss */
/* 复用 scenic-mgr.wxss 的样式 */
.mgr-container {
  padding: 20rpx 30rpx 60rpx;
  background: #f5f6fa;
  min-height: 100vh;
}

.mgr-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
}

.mgr-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
}

.add-btn {
  background: #FF6B35;
  color: #fff;
  border: none;
  border-radius: 30rpx;
  padding: 12rpx 32rpx;
  font-size: 26rpx;
}

.empty-state {
  text-align: center;
  padding: 80rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.mgr-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  margin-bottom: 16rpx;
  background: #fff;
  border-radius: 12rpx;
}

.mgr-thumb {
  width: 100rpx;
  height: 100rpx;
  border-radius: 8rpx;
  background: #eee;
  flex-shrink: 0;
}

.mgr-info {
  flex: 1;
  margin-left: 20rpx;
}

.mgr-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.mgr-desc {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.mgr-actions {
  display: flex;
  gap: 16rpx;
}

.mgr-edit, .mgr-delete {
  font-size: 32rpx;
  padding: 8rpx;
}

.mgr-edit:active, .mgr-delete:active {
  opacity: 0.6;
}