<view class="route-container">
  <view class="nav-header">
    <text class="back" bindtap="goBack">‹ 返回</text>
    <text class="title">路线规划</text>
  </view>

  <view class="input-area">
    <input class="input" placeholder="出发地 (输入地名或坐标)" bindinput="setOrigin" value="{{origin}}" />
    <input class="input" placeholder="目的地 (输入地名或坐标)" bindinput="setDestination" value="{{destination}}" />
    <view class="btn-group">
      <button class="plan-btn" bindtap="planRoute" disabled="{{loading}}">{{loading ? '规划中...' : '规划路线'}}</button>
      <button class="location-btn" bindtap="getMyLocation">📍 我的位置</button>
    </view>
  </view>

  <map
    id="map"
    longitude="{{mapCenter.longitude}}"
    latitude="{{mapCenter.latitude}}"
    scale="12"
    markers="{{markers}}"
    polyline="{{polyline}}"
    style="width:100%;height:400rpx;border-radius:16rpx;margin:20rpx 0;"
  ></map>

  <view wx:if="{{routeResult}}" class="result">
    <text class="summary">{{routeSummary}}</text>
    <view class="stats">
      <text>📏 {{routeDistance}}</text>
      <text>⏱️ {{routeTime}}</text>
      <text>💰 {{routeTolls}}</text>
    </view>
    <view class="steps">
      <view wx:for="{{routeSteps}}" wx:key="index" class="step"><text>{{index+1}}. {{item}}</text></view>
    </view>
  </view>

  <view wx:else class="placeholder">请填写出发地和目的地，点击规划路线</view>
</view>