<!-- 路线输入区 -->
<view class="route-input-area">
  <view class="input-group">
    <text class="label">出发地：</text>
    <input class="input" placeholder="请输入出发地" bindinput="onStartInput" value="{{startAddress}}"/>
  </view>
  <view class="input-group">
    <text class="label">目的地：</text>
    <input class="input" placeholder="请输入目的地" bindinput="onEndInput" value="{{endAddress}}"/>
  </view>
</view>

<!-- 按钮区域 -->
<view class="button-area">
  <button class="btn btn-primary" bindtap="planRoute">进行规划路线</button>
  <button class="btn btn-secondary" bindtap="getMyLocation">我的位置</button>
</view>

<!-- 地图区域 -->
<view class="map-area">
  <map id="map" longitude="{{longitude}}" latitude="{{latitude}}" scale="{{scale}}" markers="{{markers}}" polyline="{{polyline}}" show-location="{{showLocation}}" style="width: 100%; height: 100%;"/>
</view>

<!-- 路线详情 -->
<view class="route-detail" wx:if="{{routeInfo}}">
  <view class="detail-item">
    <text>总公里数：{{routeInfo.distance}} km</text>
  </view>
  <view class="detail-item">
    <text>预估时间：{{routeInfo.duration}} hour</text>
  </view>
  <view class="detail-item">
    <text>高速过路费：{{routeInfo.toll}} ￥</text>
  </view>
  <view class="step-list">
    <view class="step-item" wx:for="{{routeInfo.steps}}" wx:key="index">
      <text>{{item.instruction}}</text>
    </view>
  </view>
</view>