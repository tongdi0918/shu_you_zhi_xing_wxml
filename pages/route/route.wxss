/* pages/route/route.wxss */
.route-container {
  padding: 20rpx;
  background-color: #f8f9fa;
  min-height: 100vh;
}

/* 路线输入区 - 小矩形块 */
.route-input-area {
  padding: 30rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 20rpx;
}

.input-group {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.input-group:last-child {
  margin-bottom: 0;
}

.label {
  width: 140rpx;
  font-size: 30rpx;
  color: #333333;
  font-weight: 500;
}

.input {
  flex: 1;
  height: 80rpx;
  background-color: #f5f6fa;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #333;
  border: 2rpx solid #e8ecf1;
  transition: border-color 0.2s;
}

.input:focus {
  border-color: #07c160;
}

/* 按钮区域 - 小矩形块 */
.button-area {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  border: none;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.10);
}

.btn-primary {
  background: linear-gradient(135deg, #07c160, #06ad56);
}

.btn-secondary {
  background: linear-gradient(135deg, #1989fa, #0a6fc9);
}

.btn:active {
  opacity: 0.85;
  transform: scale(0.97);
}

/* 地图区域 - 小矩形块 */
.map-area {
  width: 100%;
  height: 520rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background-color: #e8ecf1;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 20rpx;
}

/* 路线详情 - 小矩形块 */
.route-detail {
  padding: 30rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.detail-item {
  padding: 22rpx 24rpx;
  background-color: #f5f6fa;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  color: #333;
  border-left: 6rpx solid #07c160;
}

.detail-item:last-of-type {
  margin-bottom: 20rpx;
}

.step-list {
  background-color: #f5f6fa;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
}

.step-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.step-item {
  padding: 18rpx 0;
  border-bottom: 2rpx solid #e8ecf1;
  font-size: 26rpx;
  color: #555;
  line-height: 1.6;
}

.step-item:last-child {
  border-bottom: none;
}