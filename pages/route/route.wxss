.route-container { padding: 20rpx 30rpx 60rpx; background: #f8f8f8; }
.nav-header { display: flex; align-items: center; margin-bottom: 30rpx; }
.back { font-size: 28rpx; color: #FF6B35; }
.title { flex: 1; text-align: center; font-size: 36rpx; font-weight: 700; color: #333; }
.input-area { background: white; border-radius: 16rpx; padding: 30rpx; box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.04); }
.input { width: 100%; height: 80rpx; border: 2rpx solid #e0e0e0; border-radius: 12rpx; padding: 0 20rpx; margin-bottom: 20rpx; font-size: 28rpx; box-sizing: border-box; }
.btn-group { display: flex; gap: 20rpx; }
.plan-btn, .location-btn { flex: 1; height: 80rpx; border-radius: 40rpx; font-size: 28rpx; display: flex; align-items: center; justify-content: center; border: none; }
.plan-btn { background: #FF6B35; color: white; }
.location-btn { background: #f0f0f0; color: #333; }
.result { background: white; border-radius: 16rpx; padding: 30rpx; box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.04); }
.summary { display: block; font-size: 32rpx; font-weight: 600; margin-bottom: 16rpx; }
.stats { display: flex; flex-wrap: wrap; gap: 20rpx; margin-bottom: 20rpx; font-size: 26rpx; color: #666; }
.steps .step { padding: 12rpx 0; border-bottom: 2rpx solid #f5f5f5; font-size: 26rpx; color: #444; }
.steps .step text { display: block; }
.placeholder { text-align: center; padding: 80rpx 0; color: #ccc; font-size: 28rpx; }