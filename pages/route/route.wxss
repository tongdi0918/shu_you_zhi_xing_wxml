/* pages/route/route.wxss */

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f5f6fa;
  padding: 10px;
  box-sizing: border-box;
}

/* ===== 输入区域 ===== */
.input-area {
  background-color: #ffffff;
  border-radius: 12px;
  padding: 14px 12px;
  margin-bottom: 10px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
}

.input-row {
  display: flex;
  align-items: center;
  margin-bottom: 10px;
}

.input-row:last-of-type {
  margin-bottom: 12px;
}

.label {
  width: 60px;
  font-size: 14px;
  color: #000000;
  flex-shrink: 0;
  font-weight: 500;
}

.input {
  flex: 1;
  height: 36px;
  border: 1px solid #e8e8e8;
  border-radius: 6px;
  padding: 0 10px;
  font-size: 14px;
  background-color: #ffffffd6;
  transition: border-color 0.2s;
}

.input:focus {
  border-color: #07c160;
}

.button-row {
  display: flex;
  justify-content: space-between;
  gap: 8px;
}

.btn-plan {
  flex: 1;
  background-color: #07c160;
  color: #fff;
  border-radius: 6px;
  font-size: 14px;
  line-height: 38px;
  text-align: center;
  border: none;
  font-weight: 500;
  box-shadow: 0 2px 6px rgba(7, 193, 96, 0.3);
}

.btn-plan:active {
  opacity: 0.85;
}

.btn-location {
  flex: 1;
  background-color: #1989fa;
  color: #fff;
  border-radius: 6px;
  font-size: 14px;
  line-height: 38px;
  text-align: center;
  border: none;
  font-weight: 500;
  box-shadow: 0 2px 6px rgba(25, 137, 250, 0.3);
}

.btn-location:active {
  opacity: 0.85;
}

/* ===== 地图区域 ===== */
.map-area {
  flex: 1;
  background-color: #ffffff;
  border-radius: 12px;
  overflow: hidden;
  margin-bottom: 10px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  min-height: 280px;
}

/* ===== 路线信息卡片（四宫格小矩形块） ===== */
.info-area {
  background-color: #ffffff;
  border-radius: 12px;
  padding: 12px 10px;
  margin-bottom: 10px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
}

.info-card {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 6px;
}

.info-item {
  width: calc(50% - 3px);
  background-color: #f7f8fc;
  border-radius: 8px;
  padding: 10px 6px;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
  border: 1px solid #f0f0f0;
}

.info-label {
  font-size: 11px;
  color: #999;
  letter-spacing: 0.5px;
}

.info-value {
  font-size: 17px;
  color: #222;
  font-weight: 700;
  margin-top: 2px;
}

/* ===== 逐段导航步骤 ===== */
.steps-area {
  background-color: #ffffff;
  border-radius: 12px;
  padding: 12px 12px 8px 12px;
  max-height: 240px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
}

.steps-title {
  font-size: 14px;
  font-weight: 700;
  color: #222;
  margin-bottom: 8px;
  padding-bottom: 6px;
  border-bottom: 2px solid #07c160;
  display: inline-block;
}

.steps-scroll {
  max-height: 180px;
}

.step-item {
  display: flex;
  align-items: flex-start;
  padding: 10px 0;
  border-bottom: 1px solid #f0f0f0;
}

.step-item:last-child {
  border-bottom: none;
}

.step-number {
  width: 24px;
  height: 24px;
  border-radius: 50%;
  background-color: #07c160;
  color: #fff;
  text-align: center;
  line-height: 24px;
  font-size: 12px;
  font-weight: 600;
  margin-right: 12px;
  flex-shrink: 0;
  margin-top: 2px;
}

.step-content {
  flex: 1;
  min-width: 0;
}

.step-instruction {
  font-size: 13px;
  color: #222;
  display: block;
  line-height: 1.5;
  font-weight: 500;
}

.step-road {
  font-size: 12px;
  color: #666;
  display: block;
  margin-top: 2px;
}

.step-distance {
  font-size: 12px;
  color: #999;
  display: block;
  margin-top: 1px;
}