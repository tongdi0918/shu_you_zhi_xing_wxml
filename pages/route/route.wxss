/* 路线输入区 - 小矩形块布局 */
.route-input-area {
  padding: 20rpx;
  background-color: #f5f5f5;
  border-radius: 20rpx;
  margin: 20rpx;
}

.input-group {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.label {
  width: 150rpx;
  font-size: 32rpx;
  color: #333;
}

.input {
  flex: 1;
  height: 80rpx;
  background-color: #fff;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
}

/* 按钮区域 - 小矩形块布局 */
.button-area {
  display: flex;
  justify-content: space-around;
  padding: 20rpx;
}

.btn {
  width: 45%;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  font-size: 32rpx;
  color: #fff;
}

.btn-primary {
  background-color: #07c160;
}

.btn-secondary {
  background-color: #1989fa;
}

/* 地图区域 */
.map-area {
  width: 100%;
  height: 500rpx;
  margin: 20rpx 0;
}

/* 路线详情 - 小矩形块布局 */
.route-detail {
  padding: 20rpx;
  background-color: #f5f5f5;
  border-radius: 20rpx;
  margin: 20rpx;
}

.detail-item {
  padding: 20rpx;
  background-color: #fff;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
  font-size: 28rpx;
}

.step-list {
  background-color: #fff;
  border-radius: 10rpx;
  padding: 20rpx;
}

.step-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee;
  font-size: 28rpx;
}