<view class="login-container">
  <view class="login-box">
    <text class="title">用户登录</text>
    <text class="subtitle">登录后获取个性化旅行推荐</text>
    
    <input class="input" placeholder="请输入用户名" bindinput="onInputUsername" value="{{username}}" />
    <input class="input" placeholder="请输入密码" password bindinput="onInputPassword" value="{{password}}" />
    
    <button class="login-btn" bindtap="doLogin" disabled="{{isLoading}}">登 录</button>
    
    <view class="register-link">
      <text>还没有账号？</text>
      <navigator url="/pages/register/register">立即注册</navigator>
    </view>
  </view>
</view>