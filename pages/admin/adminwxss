.login-container {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  background: #f0f2f5;
}
.login-box {
  background: white;
  padding: 60rpx 40rpx;
  border-radius: 24rpx;
  width: 80%;
  box-shadow: 0 8rpx 40rpx rgba(0,0,0,0.08);
}
.title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  text-align: center;
  color: #333;
}
.subtitle {
  display: block;
  text-align: center;
  color: #999;
  font-size: 26rpx;
  margin: 16rpx 0 40rpx;
}
.input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
  padding: 0 20rpx;
  margin-bottom: 30rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}
.login-btn {
  width: 100%;
  height: 80rpx;
  background: #FF6B35;
  color: white;
  border: none;
  border-radius: 40rpx;
  font-size: 32rpx;
  font-weight: 600;
}
.back-link {
  text-align: center;
  margin-top: 30rpx;
  color: #999;
  font-size: 26rpx;
}