/* pages/admin/admin.wxss */
.admin-container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding: 20rpx;
  padding-bottom: 100rpx;
}

.admin-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  padding: 20rpx 0;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.stat-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx 12rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.stat-num {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #07C160;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.tab-bar {
  display: flex;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 20rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #999;
  border-radius: 12rpx;
  transition: all 0.3s;
}

.tab-item.active {
  background-color: #07C160;
  color: #ffffff;
}

.add-btn {
  display: inline-block;
  background-color: #07C160;
  color: #ffffff;
  padding: 16rpx 32rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  margin-bottom: 20rpx;
}

.add-btn:active {
  opacity: 0.8;
}

.list {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx;
}

.list-item {
  margin-bottom: 16rpx;
}

.item-block {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx;
  background-color: #f8f8f8;
  border-radius: 12rpx;
  border: 2rpx solid #eee;
}

.item-info {
  flex: 1;
}

.item-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.item-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.item-actions {
  display: flex;
  gap: 16rpx;
}

.edit-btn,
.del-btn {
  font-size: 32rpx;
  padding: 8rpx;
}

.edit-btn:active,
.del-btn:active {
  opacity: 0.6;
}

.empty {
  text-align: center;
  padding: 60rpx 0;
  font-size: 28rpx;
  color: #999;
}

/* 对话框 */
.dialog-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.dialog-box {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx;
  width: 85%;
  max-width: 600rpx;
}

.dialog-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 30rpx;
}

.dialog-body {
  margin-bottom: 30rpx;
}

.dialog-input {
  width: 100%;
  height: 76rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid #eee;
}

.dialog-actions {
  display: flex;
  gap: 20rpx;
}

.dialog-cancel,
.dialog-confirm {
  flex: 1;
  height: 76rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  border: none;
  line-height: 76rpx;
}

.dialog-cancel {
  background-color: #f0f0f0;
  color: #666;
}

.dialog-confirm {
  background-color: #07C160;
  color: #ffffff;
}

.dialog-cancel:active,
.dialog-confirm:active {
  opacity: 0.8;
}