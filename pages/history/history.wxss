/* pages/history/history.wxss */
.history-container {
  background: #f5f5f5;
  min-height: 100vh;
  padding: 20rpx;
  padding-bottom: 100rpx;
}

.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}
.history-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}
.clear-btn {
  font-size: 28rpx;
  color: #FF6B35;
  padding: 8rpx 24rpx;
  border: 2rpx solid #FF6B35;
  border-radius: 30rpx;
}
.clear-btn:active {
  background: #FF6B35;
  color: #fff;
}

.loading-tip {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding: 80rpx 0;
}

.list-container {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.item-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
  transition: all 0.2s;
}
.item-card:active {
  transform: scale(0.98);
  background: #fafafa;
}

.item-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #e8e8e8;
}

.item-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.item-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}
.item-location {
  font-size: 24rpx;
  color: #999;
}

.item-time {
  font-size: 22rpx;
  color: #bbb;
  flex-shrink: 0;
  margin-left: 10rpx;
}

.empty-tip {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding: 80rpx 0;
}