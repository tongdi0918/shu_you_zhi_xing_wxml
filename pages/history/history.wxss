/* pages/history/history.wxss */
.history-container {
  background: #f5f5f5;
  min-height: 100vh;
  padding: 20rpx;
}

.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}
.history-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}
.history-clear {
  font-size: 28rpx;
  color: #FF6B35;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  border: 1rpx solid #FF6B35;
}
.history-clear:active {
  background: #FF6B35;
  color: #fff;
}

.history-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
  transition: all 0.2s;
}
.history-item:active {
  transform: scale(0.98);
  background: #fafafa;
}

.history-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #e8e8e8;
}
.history-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.history-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}
.history-location {
  font-size: 24rpx;
  color: #999;
}
.history-time {
  font-size: 22rpx;
  color: #bbb;
  margin-top: 4rpx;
}

.empty-tip {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding: 120rpx 0;
}