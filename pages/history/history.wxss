/* pages/history/history.wxss */
.history-container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding: 20rpx;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.header-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.clear-btn {
  font-size: 26rpx;
  color: #ff6b6b;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  background-color: #fff5f5;
}

.clear-btn:active {
  background-color: #ffe8e8;
}

.list {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.list-item {
  margin-bottom: 16rpx;
}

.item-block {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background-color: #f8f8f8;
  border-radius: 12rpx;
  border: 2rpx solid #eee;
  transition: all 0.2s;
}

.item-block:active {
  transform: scale(0.98);
  border-color: #07C160;
}

.item-type {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.item-info {
  flex: 1;
}

.item-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.item-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.item-time {
  font-size: 22rpx;
  color: #bbb;
}

.empty {
  text-align: center;
  padding: 80rpx 0;
  font-size: 28rpx;
  color: #999;
}