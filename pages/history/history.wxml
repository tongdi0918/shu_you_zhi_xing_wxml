<!-- pages/history/history.wxml -->
<view class="history-container">
  <view class="header">
    <text class="header-title">📜 浏览历史</text>
    <text class="clear-btn" bindtap="clearHistory" wx:if="{{historyList.length > 0}}">清空</text>
  </view>

  <view class="list">
    <view class="list-item" wx:for="{{historyList}}" wx:key="_id" bindtap="viewDetail" data-id="{{item._id}}" data-type="{{item.type}}">
      <view class="item-block">
        <view class="item-type">{{item.type === 'scenic' ? '🏔️' : '🍜'}}</view>
        <view class="item-info">
          <view class="item-name">{{item.name || '未知'}}</view>
          <view class="item-desc">{{item.type === 'scenic' ? item.location : item.shop}}</view>
        </view>
        <view class="item-time">{{item.viewTime ? item.viewTime.substring(0, 10) : ''}}</view>
      </view>
    </view>
    <view class="empty" wx:if="{{historyList.length === 0}}">暂无浏览历史</view>
  </view>
</view>