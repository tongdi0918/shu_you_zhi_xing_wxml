<!-- pages/dashboard/dashboard.wxml -->
<view class="dashboard-container">
  <view class="dashboard-header">
    <text class="dashboard-title">📊 数据统计</text>
    <text class="dashboard-back" bindtap="goBack">返回</text>
  </view>

  <view class="stats-grid">
    <view class="stat-card">
      <text class="stat-number">{{stats.sceneries}}</text>
      <text class="stat-label">🏞️ 景区</text>
    </view>
    <view class="stat-card">
      <text class="stat-number">{{stats.foods}}</text>
      <text class="stat-label">🍜 美食</text>
    </view>
    <view class="stat-card">
      <text class="stat-number">{{stats.users}}</text>
      <text class="stat-label">👤 用户</text>
    </view>
    <view class="stat-card">
      <text class="stat-number">{{stats.orders}}</text>
      <text class="stat-label">📦 订单</text>
    </view>
  </view>

  <view class="admin-menu">
    <view class="admin-btn" bindtap="goToScenicMgr">
      <text class="admin-icon">🏞️</text>
      <text>景区管理</text>
    </view>
    <view class="admin-btn" bindtap="goToFoodMgr">
      <text class="admin-icon">🍜</text>
      <text>美食管理</text>
    </view>
    <view class="admin-btn" bindtap="goToUserMgr">
      <text class="admin-icon">👤</text>
      <text>用户管理</text>
    </view>
  </view>
</view>