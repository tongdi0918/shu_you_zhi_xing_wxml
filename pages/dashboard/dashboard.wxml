<view class="dashboard-container">
  <text class="title">🛠️ 管理后台</text>

  <view class="stats">
    <view class="stat-item">
      <text class="num">{{stats.sceneries}}</text>
      <text class="label">景区</text>
    </view>
    <view class="stat-item">
      <text class="num">{{stats.foods}}</text>
      <text class="label">美食</text>
    </view>
    <view class="stat-item">
      <text class="num">{{stats.users}}</text>
      <text class="label">用户</text>
    </view>
    <view class="stat-item">
      <text class="num">{{stats.orders}}</text>
      <text class="label">订单</text>
    </view>
  </view>

  <view class="menu-group">
    <view class="menu-item" bindtap="goToScenicMgr">🏔️ 景点管理</view>
    <view class="menu-item" bindtap="goToFoodMgr">🍜 美食管理</view>
    <view class="menu-item" bindtap="goToUserMgr">👤 用户管理</view>
  </view>

  <view class="back-btn" bindtap="goBack">← 返回首页</view>
</view>