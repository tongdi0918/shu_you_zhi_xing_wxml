/* pages/dashboard/dashboard.wxss */
.dashboard-container {
  background: #f5f5f5;
  min-height: 100vh;
  padding: 20rpx;
}

.dashboard-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}
.dashboard-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}
.dashboard-back {
  font-size: 28rpx;
  color: #FF6B35;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  border: 1rpx solid #FF6B35;
}
.dashboard-back:active {
  background: #FF6B35;
  color: #fff;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-bottom: 30rpx;
}
.stat-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx 20rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}
.stat-number {
  display: block;
  font-size: 56rpx;
  font-weight: bold;
  color: #FF6B35;
}
.stat-label {
  display: block;
  font-size: 26rpx;
  color: #999;
  margin-top: 8rpx;
}

.admin-menu {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}
.admin-btn {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx 0;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
  font-size: 26rpx;
  color: #333;
  transition: all 0.2s;
}
.admin-btn:active {
  transform: scale(0.95);
  background: #fafafa;
}
.admin-icon {
  display: block;
  font-size: 48rpx;
  margin-bottom: 10rpx;
}