/* pages/profile/profile.wxss */
.profile-container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding: 20rpx;
  padding-bottom: 120rpx;
}

/* ===== 用户信息卡片 ===== */
.user-card {
  background: linear-gradient(135deg, #07C160, #06AD56);
  border-radius: 24rpx;
  padding: 40rpx 30rpx 30rpx;
  margin-bottom: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.3);
}
.avatar-wrapper {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 6rpx solid #ffffff;
  overflow: hidden;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}
.avatar {
  width: 100%;
  height: 100%;
}
.user-name {
  font-size: 40rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 8rpx;
}
.login-register-row {
  display: flex;
  align-items: center;
  margin-top: 6rpx;
}
.login-btn,
.register-btn {
  font-size: 32rpx;
  color: #ffffff;
  padding: 10rpx 30rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.6);
  border-radius: 40rpx;
}
.login-btn:active,
.register-btn:active {
  background-color: rgba(255, 255, 255, 0.2);
}
.divider {
  color: rgba(255, 255, 255, 0.5);
  margin: 0 20rpx;
  font-size: 28rpx;
}
.user-city {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  justify-content: center;
}
.city-label {
  opacity: 0.8;
}
.city-value {
  font-weight: bold;
  margin: 0 8rpx;
}
.city-edit {
  color: #fff;
  background-color: rgba(255, 255, 255, 0.2);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}
.admin-badge {
  margin-top: 12rpx;
  background-color: rgba(255, 255, 255, 0.25);
  color: #fff;
  font-size: 24rpx;
  padding: 4rpx 24rpx;
  border-radius: 20rpx;
}

/* ===== 功能菜单 ===== */
.menu-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx 16rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}
.menu-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0;
  border-radius: 16rpx;
  transition: all 0.2s;
}
.menu-item:active {
  background-color: #f0f0f0;
  transform: scale(0.95);
}
.menu-icon {
  font-size: 44rpx;
  margin-bottom: 6rpx;
}
.menu-text {
  font-size: 22rpx;
  color: #333333;
}

/* ===== 成就区域 ===== */
.achievement-section {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 30rpx 24rpx 36rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}
.achievement-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
}
.achievement-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}
.achievement-sub {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}
.achievement-count {
  font-size: 26rpx;
  color: #07C160;
  margin-top: 10rpx;
  background-color: #f0faf5;
  padding: 6rpx 24rpx;
  border-radius: 30rpx;
}

/* ===== Tab 切换 ===== */
.tab-bar {
  display: flex;
  border-radius: 40rpx;
  background-color: #f5f5f5;
  padding: 6rpx;
  margin-bottom: 24rpx;
}
.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #666;
  border-radius: 40rpx;
  transition: all 0.3s;
  position: relative;
}
.tab-item.active {
  background-color: #07C160;
  color: #fff;
  font-weight: bold;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.3);
}
.tab-badge {
  display: inline-block;
  background-color: rgba(0, 0, 0, 0.1);
  border-radius: 30rpx;
  padding: 0 16rpx;
  font-size: 22rpx;
  margin-left: 8rpx;
}
.tab-item.active .tab-badge {
  background-color: rgba(255, 255, 255, 0.3);
}

/* ===== 卡片网格（小矩形块） ===== */
.card-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}
.card-item {
  position: relative;
  background-color: #fafafa;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  transition: all 0.25s ease;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-bottom: 12rpx;
  border: 2rpx solid #eee;
}
.card-item:active {
  transform: scale(0.96);
}
.card-item.checked {
  border-color: #07C160;
  background-color: #f0faf5;
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.15);
}
.card-image {
  width: 100%;
  height: 160rpx;
  background-color: #e8e8e8;
  display: block;
}
.card-name {
  font-size: 26rpx;
  color: #333;
  margin-top: 10rpx;
  text-align: center;
  font-weight: 500;
  padding: 0 8rpx;
  word-break: break-all;
  line-height: 1.4;
}
.check-mark {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 44rpx;
  height: 44rpx;
  background-color: #07C160;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
  box-shadow: 0 2rpx 8rpx rgba(7, 193, 96, 0.4);
}
.loading-tip,
.empty-tip {
  text-align: center;
  padding: 60rpx 0;
  font-size: 28rpx;
  color: #999;
}