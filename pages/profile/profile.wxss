/* pages/profile/profile.wxss */
.profile-container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding: 20rpx;
  padding-bottom: 100rpx;
}

/* ===== 用户信息卡片 ===== */
.user-card {
  background: linear-gradient(135deg, #07C160, #06AD56);
  border-radius: 24rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.3);
}
.avatar-wrapper {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 6rpx solid #ffffff;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}
.avatar {
  width: 100%;
  height: 100%;
}
.user-name {
  font-size: 40rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 10rpx;
}
.login-register-row {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}
.login-btn, .register-btn {
  font-size: 32rpx;
  color: #ffffff;
  padding: 10rpx 30rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.6);
  border-radius: 40rpx;
  transition: all 0.3s;
}
.login-btn:active, .register-btn:active {
  background-color: rgba(255, 255, 255, 0.2);
}
.divider {
  color: rgba(255, 255, 255, 0.5);
  margin: 0 20rpx;
  font-size: 28rpx;
}
.user-city {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  justify-content: center;
}
.city-label {
  opacity: 0.8;
}
.city-value {
  font-weight: bold;
  margin: 0 8rpx;
}
.city-edit {
  color: #fff;
  background-color: rgba(255, 255, 255, 0.2);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

/* ===== 功能菜单 ===== */
.menu-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 30rpx 20rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}
.menu-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
  border-radius: 16rpx;
  transition: all 0.2s;
}
.menu-item:active {
  background-color: #f0f0f0;
  transform: scale(0.95);
}
.menu-icon {
  font-size: 48rpx;
  margin-bottom: 10rpx;
}
.menu-text {
  font-size: 24rpx;
  color: #333333;
}

/* ===== 成就区域 ===== */
.achievement-section {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 30rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}
.section-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.achieve-group {
  margin-bottom: 30rpx;
}
.achieve-group:last-child {
  margin-bottom: 0;
}

.achieve-header {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  cursor: pointer;
}
.achieve-label {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
}
.achieve-count {
  font-size: 26rpx;
  color: #FF6B35;
  margin-right: 16rpx;
}
.achieve-arrow {
  font-size: 28rpx;
  color: #999;
}

/* 成就网格 - 小矩形块布局 */
.achieve-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  padding-top: 20rpx;
}
.achieve-item {
  background: #fafafa;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  transition: all 0.3s ease;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-bottom: 12rpx;
  border: 3rpx solid transparent;
}
.achieve-item.highlight {
  transform: translateY(-12rpx) scale(1.04);
  box-shadow: 0 12rpx 32rpx rgba(255, 107, 53, 0.25);
  border-color: #FF6B35;
  background: #fff8f5;
}
.achieve-thumb {
  width: 100%;
  height: 160rpx;
  background: #e8e8e8;
  display: block;
}
.achieve-name {
  font-size: 26rpx;
  color: #333;
  margin-top: 10rpx;
  text-align: center;
  font-weight: 500;
  padding: 0 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  width: 100%;
}
.achieve-status {
  font-size: 22rpx;
  color: #07C160;
  margin-top: 4rpx;
}

.empty-tip {
  grid-column: 1 / -1;
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding: 40rpx 0;
}