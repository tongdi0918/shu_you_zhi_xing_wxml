/* pages/profile/profile.wxss */
.profile-container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding: 20rpx;
  padding-bottom: 100rpx;
}

/* 用户信息卡片 */
.user-card {
  background: linear-gradient(135deg, #07C160, #06AD56);
  border-radius: 24rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.3);
}

.avatar-wrapper {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 6rpx solid #ffffff;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}

.avatar {
  width: 100%;
  height: 100%;
}

.user-name {
  font-size: 40rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 10rpx;
}

.login-register-row {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}

.login-btn,
.register-btn {
  font-size: 32rpx;
  color: #ffffff;
  padding: 10rpx 30rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.6);
  border-radius: 40rpx;
  transition: all 0.3s;
}

.login-btn:active,
.register-btn:active {
  background-color: rgba(255, 255, 255, 0.2);
}

.divider {
  color: rgba(255, 255, 255, 0.5);
  margin: 0 20rpx;
  font-size: 28rpx;
}

.user-city {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  justify-content: center;
}

.city-label {
  opacity: 0.8;
}

.city-value {
  font-weight: bold;
  margin: 0 8rpx;
}

.city-edit {
  color: #fff;
  background-color: rgba(255, 255, 255, 0.2);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

/* 功能菜单 */
.menu-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 30rpx 20rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.menu-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
  border-radius: 16rpx;
  transition: all 0.2s;
}

.menu-item:active {
  background-color: #f0f0f0;
  transform: scale(0.95);
}

.menu-icon {
  font-size: 48rpx;
  margin-bottom: 10rpx;
}

.menu-text {
  font-size: 24rpx;
  color: #333333;
}

/* 成就区域 */
.achievement-section {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 30rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.section-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.achievement-group {
  margin-bottom: 24rpx;
}

.achievement-group:last-child {
  margin-bottom: 0;
}

.group-header {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background-color: #f8f8f8;
  border-radius: 16rpx;
  cursor: pointer;
  transition: all 0.2s;
}

.group-header:active {
  background-color: #efefef;
}

.group-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
}

.group-count {
  font-size: 24rpx;
  color: #999;
  margin-right: 16rpx;
}

.group-arrow {
  font-size: 24rpx;
  color: #999;
}

.achievement-list {
  margin-top: 16rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.achievement-item {
  cursor: pointer;
}

.achievement-block {
  background-color: #f8f8f8;
  border-radius: 16rpx;
  padding: 20rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 2rpx solid #e8e8e8;
  transition: all 0.3s;
}

.achievement-block:active {
  transform: scale(1.05);
  border-color: #07C160;
  background-color: #f0fff4;
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.2);
}

.achievement-name {
  font-size: 24rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.achievement-status {
  font-size: 22rpx;
  color: #07C160;
}

.empty-tip {
  grid-column: 1 / -1;
  text-align: center;
  font-size: 26rpx;
  color: #999;
  padding: 30rpx 0;
}