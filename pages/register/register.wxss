/* pages/register/register.wxss */
.register-container {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #e3f2fd, #bbdefb);
  padding: 40rpx;
}

.register-card {
  background-color: #ffffff;
  border-radius: 32rpx;
  padding: 60rpx 40rpx;
  width: 100%;
  max-width: 600rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.1);
}

.register-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 40rpx;
}

.input-group {
  margin-bottom: 32rpx;
}

.input-wrapper {
  display: flex;
  align-items: center;
  background-color: #f5f5f5;
  border-radius: 16rpx;
  padding: 0 24rpx;
  margin-bottom: 20rpx;
  height: 88rpx;
}

.input-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.input-field {
  flex: 1;
  font-size: 30rpx;
  color: #333;
  height: 100%;
}

.register-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #42A5F5, #1E88E5);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 16rpx;
  border: none;
  line-height: 88rpx;
}

.register-btn:active {
  opacity: 0.8;
}

.login-tip {
  text-align: center;
  font-size: 28rpx;
  color: #999;
  margin-top: 30rpx;
}

.login-link {
  color: #42A5F5;
  font-weight: bold;
  margin-left: 8rpx;
}